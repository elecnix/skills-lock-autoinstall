{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/restore-skills.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": "skills-lock.json",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/restore-skills.sh watch",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
